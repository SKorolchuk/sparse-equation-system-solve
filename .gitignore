# --- Go Compilation Artifacts ---
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof
bin/

# --- WebAssembly Assets ---
# These are generated dynamically by 'make build-wasm' inside the web context
web/app/public/solver.wasm
web/app/public/wasm_exec.js

# --- Frontend Node & Build Directories ---
# Vite production bundle directory
web/dist/

# Local dependencies cache (must never be committed)
node_modules/
web/app/node_modules/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE and System Specific Files ---
# JetBrains (GoLand / WebStorm)
.idea/

# Visual Studio Code
.vscode/
*.code-workspace

# Local OS files
.DS_Store
Thumbs.db
